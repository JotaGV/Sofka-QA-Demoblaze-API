              "pm.test(\"El servicio responde con HTTP 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"El servicio rechaza el usuario o la contraseña incorrectos\", function () {\r\n    const respuesta = pm.response.json();\r\n\r\n    pm.expect(respuesta.errorMessage).to.be.oneOf([\r\n        \"User does not exist.\",\r\n        \"Wrong password.\"\r\n    ]);\r\n});\r\n"
